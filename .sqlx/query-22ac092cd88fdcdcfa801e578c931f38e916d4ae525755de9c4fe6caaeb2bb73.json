  "query": "\n            SELECT\n                id,\n                account_name,\n                status,\n                pr_idempotency_key,\n                unsigned_tx_json,\n                signed_tx_json,\n                error_message,\n                retry_count,\n                intermediate_context_json,\n                mined_height,\n                mined_header_hash,\n                mined_timestamp,\n                created_at as \"created_at: DateTime<Utc>\",\n                updated_at as \"updated_at: DateTime<Utc>\"\n            FROM payment_batches\n            WHERE status = ? AND mined_height >= ?\n            ORDER BY mined_height ASC\n            ",
